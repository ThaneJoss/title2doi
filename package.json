{
  "name": "title2doi",
  "version": "1.0.0",
  "private": true,
  "description": "Batch DOI lookup and Zotero metadata repair with Crossref",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "dev": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "check:worker": "wrangler deploy --dry-run",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "wrangler": "4.149.0"
  }
}
