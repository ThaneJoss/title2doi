{
  "name": "title2doi",
  "version": "1.0.0",
  "private": true,
  "description": "Batch DOI lookup and Zotero metadata repair with Crossref",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "dev": "wrangler dev",
    "deploy:worker": "node scripts/deploy-worker.mjs",
    "check:worker": "node scripts/deploy-worker.mjs --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
